{
  "info": {
    "name": "GameFlix API",
    "description": "Complete API collection for GameFlix video game subscription platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman@gameflix.com\",\n  \"password\": \"Postman@123\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.data.accessToken);",
                  "    pm.test('JWT captured', function() { pm.expect(json.data.accessToken).to.be.a('string'); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane@gameflix.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('admin_token', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gameflix.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/auth/logout"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN\"\n}"
            },
            "url": "{{base_url}}/api/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Games",
      "item": [
        {
          "name": "List Games",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/games?page=0&size=20&sort=title,asc"
          }
        },
        {
          "name": "Get Game by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/games/1"
          }
        },
        {
          "name": "Search Games",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/games/search?q=cyber&page=0&size=20"
          }
        },
        {
          "name": "Create Game (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Game\",\n  \"genre\": \"Action\",\n  \"description\": \"Created via Postman\",\n  \"developer\": \"Test Dev\",\n  \"publisher\": \"Test Pub\",\n  \"releaseYear\": 2025,\n  \"rating\": 7.5,\n  \"coverImageUrl\": \"https://picsum.photos/seed/postman/400/600\",\n  \"platforms\": [\"PC\"],\n  \"availableOnPlan\": \"BASIC\"\n}"
            },
            "url": "{{base_url}}/api/games"
          }
        },
        {
          "name": "Update Game (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Game Title\",\n  \"genre\": \"RPG\",\n  \"description\": \"Updated description\",\n  \"developer\": \"Test Dev\",\n  \"publisher\": \"Test Pub\",\n  \"releaseYear\": 2025,\n  \"rating\": 8.0,\n  \"coverImageUrl\": \"https://picsum.photos/seed/updated/400/600\",\n  \"platforms\": [\"PC\", \"Xbox\"],\n  \"availableOnPlan\": \"STANDARD\"\n}"
            },
            "url": "{{base_url}}/api/games/1"
          }
        },
        {
          "name": "Delete Game (Admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/games/99"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "List Plans",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/subscriptions/plans"
          }
        },
        {
          "name": "Get My Subscription",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/subscriptions/my"
          }
        },
        {
          "name": "Subscribe",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 2\n}"
            },
            "url": "{{base_url}}/api/subscriptions/subscribe"
          }
        },
        {
          "name": "Pause Subscription",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/subscriptions/my/pause"
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/subscriptions/my/cancel"
          }
        },
        {
          "name": "Upgrade Plan",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 3\n}"
            },
            "url": "{{base_url}}/api/subscriptions/my/upgrade"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "Change User Role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": "{{base_url}}/api/admin/users/2/role"
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/admin/stats"
          }
        },
        {
          "name": "List All Subscriptions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/admin/subscriptions"
          }
        }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "No Token - Expect 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', function() { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/users/me"
          }
        },
        {
          "name": "Fake Token - Expect 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', function() { pm.response.to.have.status(403); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake.token" }],
            "url": "{{base_url}}/api/users/me"
          }
        }
      ]
    }
  ]
}
